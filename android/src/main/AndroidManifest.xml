<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.geekbros.plugins.callservice">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application>
        <service
            android:name="com.geekbros.plugins.callservice.HostAvailabilityService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Host waiting to receive incoming pay-to-talk calls while app is backgrounded" />
        </service>

        <service
            android:name="com.geekbros.plugins.callservice.CallForegroundService"
            android:foregroundServiceType="phoneCall|microphone|camera"
            android:exported="false" />

        <receiver
            android:name="com.geekbros.plugins.callservice.CallNotificationReceiver"
            android:exported="false" />

        <!-- Remove default push notifications service so ours receives MESSAGING_EVENT exclusively -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <!-- Custom Firebase Messaging Service handling incoming_call natively and delegating other pushes -->
        <service
            android:name="com.geekbros.plugins.callservice.CallMessagingService"
            android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- BroadcastReceiver for Notification Reject button action -->
        <receiver
            android:name="com.geekbros.plugins.callservice.CallActionReceiver"
            android:exported="false" />

        <!-- Native Incoming Call Activity displayed over Lockscreen and App -->
        <activity
            android:name="com.geekbros.plugins.callservice.IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@style/Theme.CallService.IncomingCall"
            android:screenOrientation="portrait" />
    </application>
</manifest>
